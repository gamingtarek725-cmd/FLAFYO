<Window x:Class="Flafyo.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FLAFYO GAME TRANSLATOR" Width="460" Height="640" ResizeMode="CanMinimize"
        Background="#0E0F14" FlowDirection="RightToLeft" WindowStartupLocation="CenterScreen">
  <StackPanel Margin="24">
    <TextBlock Text="FLAFYO GAME TRANSLATOR" Foreground="#00D9A5" FontSize="22" FontWeight="Bold" FlowDirection="LeftToRight" HorizontalAlignment="Center"/>
    <TextBlock x:Name="StatusText" Text="جاهز" Foreground="White" FontSize="16" Margin="0,18,0,0" TextWrapping="Wrap"/>
    <TextBlock x:Name="RegionText" Text="لم يتم اختيار منطقة بعد" Foreground="#9AA0B4" Margin="0,6,0,0"/>
    <TextBlock x:Name="LatencyText" Text="" Foreground="#9AA0B4" Margin="0,6,0,0"/>

    <Button x:Name="SelectButton" Content="١) اختر منطقة النص في اللعبة" Margin="0,20,0,0" Padding="10" FontSize="15" Click="Select_Click"/>

    <Border BorderBrush="#2A2D3A" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,16,0,0">
      <StackPanel>
        <TextBlock Text="الترجمة بدون إنترنت (ذكاء اصطناعي)" Foreground="White" FontWeight="Bold"/>
        <TextBlock x:Name="PackText" Text="" Foreground="#9AA0B4" Margin="0,6,0,0" TextWrapping="Wrap"/>
        <Button x:Name="PackButton" Content="تنزيل حزمة الترجمة (حوالي 145 ميجا، مرة واحدة)" Margin="0,8,0,0" Padding="8" Click="Pack_Click"/>
      </StackPanel>
    </Border>

    <TextBlock Text="سرعة المعالجة:" Foreground="White" Margin="0,16,0,4"/>
    <ComboBox x:Name="SpeedBox" SelectedIndex="1" SelectionChanged="Speed_Changed">
      <ComboBoxItem Content="جهاز ضعيف (أخف)"/>
      <ComboBoxItem Content="متوازن"/>
      <ComboBoxItem Content="أسرع"/>
    </ComboBox>
    <Button x:Name="StartButton" Content="٢) ابدأ الترجمة" Margin="0,16,0,0" Padding="10" FontSize="15" Click="Start_Click"/>
    <Button x:Name="StopButton" Content="إيقاف" Margin="0,8,0,0" Padding="10" FontSize="15" IsEnabled="False" Click="Stop_Click"/>
    <TextBlock Text="الترجمة تظهر في شريط شفاف فوق منطقة النص ولا تمنع الماوس أو الكيبورد. شغّل اللعبة في وضع Windowed أو Borderless."
               Foreground="#9AA0B4" TextWrapping="Wrap" Margin="0,16,0,0" FontSize="12"/>
  </StackPanel>
</Window>
