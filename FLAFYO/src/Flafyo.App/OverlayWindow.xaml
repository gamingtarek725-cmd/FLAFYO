<Window x:Class="Flafyo.Desktop.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ShowActivated="False" Focusable="False" ResizeMode="NoResize"
        SizeToContent="Height" Width="600" FlowDirection="RightToLeft">
  <Border Background="#E6101018" CornerRadius="8" Padding="14,8" BorderBrush="#FF00D9A5" BorderThickness="1">
    <TextBlock x:Name="Label" Foreground="White" FontSize="22" TextWrapping="Wrap" FontFamily="Segoe UI"/>
  </Border>
</Window>
