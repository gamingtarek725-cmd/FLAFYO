<Window x:Class="Flafyo.Desktop.RegionSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="#66000000" Topmost="True"
        ShowInTaskbar="False" ResizeMode="NoResize" Cursor="Cross" WindowStartupLocation="Manual">
  <Canvas x:Name="Root" Background="Transparent">
    <TextBlock x:Name="Hint" Text="اسحب بالماوس حول مكان النص (الترجمة/الحوار). Esc للإلغاء" Foreground="White" FontSize="22"
               Canvas.Left="40" Canvas.Top="30" FlowDirection="RightToLeft"/>
    <Rectangle x:Name="Box" Stroke="#00D9A5" StrokeThickness="2" Fill="#2200D9A5" Visibility="Collapsed"/>
  </Canvas>
</Window>
