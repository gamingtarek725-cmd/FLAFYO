<Window x:Class="Flafyo.Desktop.LocalizationLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="مكتبة التعريبات | FLAFYO" Icon="Assets/flafyo.ico"
        Width="1280" Height="900" MinWidth="960" MinHeight="700"
        Background="{StaticResource Page}" FlowDirection="RightToLeft"
        FontFamily="Segoe UI, Tahoma" FontSize="13" WindowStartupLocation="CenterOwner">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
      <RowDefinition Height="190"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="مكتبة التعريبات" FontSize="27" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
        <TextBlock Text="اكتشف التعريبات وتحديثاتها، وتأكد من المنصة وإصدار اللعبة قبل الانتقال للمصدر." Style="{StaticResource MutedText}" Margin="0,5,0,0"/>
        <TextBlock x:Name="UpdateStatus" Text="يتم فحص آخر تحديثات المكتبة عند فتح القسم" Style="{StaticResource MutedText}" Margin="0,7,0,0"/>
      </StackPanel>
      <Button x:Name="RefreshButton" Grid.Column="1" Content="⟳  تحديث المكتبة" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Margin="14,0,0,0" Padding="18,12" Click="RefreshLibrary_Click"/>
    </Grid>
    <Grid Grid.Row="1" Margin="0,0,0,14">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBox x:Name="SearchBox" Grid.Column="0" Padding="13,10" FontSize="14" TextChanged="SearchBox_TextChanged" ToolTip="ابحث باسم اللعبة أو فريق التعريب" VerticalContentAlignment="Center"/>
      <TextBlock Grid.Column="1" x:Name="CountText" Text="0 عنصر" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="16,0,4,0" FontWeight="SemiBold"/>
      <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0" x:Name="CategoryFilters">
        <Button Content="الكل" Tag="all" Click="Category_Click" Background="#20BFD0" Foreground="#FFFFFF" Padding="15,7" Margin="0,0,7,0"/>
        <Button Content="PC" Tag="pc" Click="Category_Click" Padding="15,7" Margin="0,0,7,0"/>
        <Button Content="منصات أخرى" Tag="console" Click="Category_Click" Padding="15,7" Margin="0,0,7,0"/>
        <Button Content="Android" Tag="mobile" Click="Category_Click" Padding="15,7" Margin="0,0,7,0"/>
        <Button Content="تعريبات جديدة" Tag="new" Click="Category_Click" Padding="15,7" Margin="0,0,7,0"/>
        <Button Content="مكتبات خارجية" Tag="directories" Click="Category_Click" Padding="15,7" Margin="0,0,7,0"/>
      </WrapPanel>
    </Grid>
    <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Padding="12" Margin="0,0,0,12">
      <ListBox x:Name="EntriesList" BorderThickness="0" Background="Transparent" SelectionChanged="EntriesList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" IsItemsHost="True"/></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="5"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="CardBorder" Background="#171E35" BorderBrush="#343D5E" BorderThickness="1" CornerRadius="14" Padding="8"><ContentPresenter/></Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="CardBorder" Property="BorderBrush" Value="#20C5D5"/><Setter TargetName="CardBorder" Property="BorderThickness" Value="2"/><Setter TargetName="CardBorder" Property="Background" Value="#1C2942"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CardBorder" Property="BorderBrush" Value="#4A668C"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid Width="224" Height="190">
              <Grid.RowDefinitions><RowDefinition Height="122"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Border CornerRadius="12" ClipToBounds="True" Background="#202A48">
                <Grid>
                  <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#29234A" Offset="0"/><GradientStop Color="#101629" Offset="1"/></LinearGradientBrush></Grid.Background>
                  <TextBlock Text="FLAFYO  /  ARABIC PATCH" Foreground="#C4B5FD" FontSize="9" FontWeight="Bold" Margin="10,9" VerticalAlignment="Top" FlowDirection="LeftToRight"/>
                  <TextBlock Text="{Binding Title}" Foreground="White" FontSize="17" FontWeight="Bold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" TextAlignment="Center" VerticalAlignment="Center" Margin="10,20"/>
                  <Border Background="#D98B5CF6" CornerRadius="8" Padding="7,3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="7"><TextBlock Text="{Binding SourceName}" Foreground="#071321" FontSize="10" FontWeight="Bold"/></Border>
                </Grid>
              </Border>
              <StackPanel Grid.Row="1" Margin="3,7,3,0">
                <TextBlock Text="{Binding Title}" Foreground="{StaticResource Ink}" FontWeight="Bold" FontSize="12" TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
                <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
                <TextBlock Text="{Binding KindLabel}" Foreground="#67E8F9" FontSize="9" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock x:Name="DetailTitle" Text="اختار تعريبًا لعرض التفاصيل" Style="{StaticResource H}" FontSize="17"/>
            <TextBlock x:Name="DetailSubtitle" Style="{StaticResource MutedText}" Margin="0,3,0,7"/>
            <TextBlock x:Name="DetailMetadata" Foreground="#8FA4C8" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <TextBlock x:Name="DetailInfo" Foreground="{StaticResource Ink}" TextWrapping="Wrap"/>
            <TextBlock x:Name="InstallSteps" Style="{StaticResource MutedText}" Margin="0,5,0,0"/>
            <TextBlock x:Name="SafetyNotes" Style="{StaticResource WarnText}" Margin="0,5,0,0"/>
            <TextBlock x:Name="SourceAddress" Style="{StaticResource MutedText}" Margin="0,5,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </ScrollViewer>
        <Button x:Name="OpenSourceButton" Grid.Column="1" Content="افتح صفحة المصدر  ↗" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Margin="14,0,0,0" IsEnabled="False" Click="OpenSource_Click"/>
      </Grid>
    </Border>
    <TextBlock Grid.Row="4" Text="FLAFYO يعرض بيانات وروابط المصادر الأصلية ولا يعيد توزيع ملفات التعريب دون إذن أصحابها. التوافق لم يُختبر تلقائيًا؛ راجع صفحة المصدر قبل التثبيت." Style="{StaticResource MutedText}" Margin="2,2,2,0"/>
  </Grid>
</Window>