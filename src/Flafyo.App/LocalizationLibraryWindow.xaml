<Window x:Class="Flafyo.Desktop.LocalizationLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="مكتبة التعريبات | FLAFYO" Icon="Assets/flafyo.ico"
        Width="980" Height="760" MinWidth="760" MinHeight="580"
        Background="{StaticResource Page}" FlowDirection="RightToLeft"
        FontFamily="Segoe UI, Tahoma" FontSize="13"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="مكتبة التعريبات العربية" FontSize="23" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
        <TextBlock Text="ابحث عن تعريب لعبتك، راجع التوافق وطريقة التثبيت، ثم انتقل إلى صفحة صاحب التعريب أو مصدره الأصلي."
                   Style="{StaticResource MutedText}" Margin="0,5,0,0"/>
        <TextBlock x:Name="UpdateStatus" Text="سيتم فحص آخر تحديثات المكتبة عند فتح القسم" Style="{StaticResource MutedText}" Margin="0,5,0,0"/>
      </StackPanel>
      <Button x:Name="RefreshButton" Grid.Column="1" Content="تحديث الآن" Style="{StaticResource PrimaryButton}"
              VerticalAlignment="Center" Margin="12,0,0,0" Padding="16,10" Click="RefreshLibrary_Click"/>
    </Grid>

    <Grid Grid.Row="1" Margin="0,0,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
      <TextBox x:Name="SearchBox" Padding="11" FontSize="14" TextChanged="SearchBox_TextChanged"
               ToolTip="اكتب اسم اللعبة أو فريق التعريب"/>
      <ComboBox x:Name="CategoryBox" Grid.Column="1" Margin="10,0,0,0"
                SelectionChanged="CategoryBox_SelectionChanged" SelectedIndex="0">
        <ComboBoxItem Content="كل المصادر"/>
        <ComboBoxItem Content="تعريبات موثقة"/>
        <ComboBoxItem Content="مكتبات خارجية"/>
      </ComboBox>
    </Grid>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.3*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="10">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="الألعاب والمصادر" Style="{StaticResource H}" Margin="5,5,5,10"/>
          <ListBox x:Name="EntriesList" BorderThickness="0" Background="Transparent"
                   SelectionChanged="EntriesList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Background="#17233A" BorderBrush="#2B3A57" BorderThickness="1" CornerRadius="10" Padding="11" Margin="2,3">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource Ink}" FontWeight="Bold" FontSize="14"/>
                    <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding KindLabel}" Foreground="#8EA7FF" FontSize="10" Margin="0,5,0,0"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0" Padding="18">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock x:Name="DetailTitle" Text="اختار لعبة أو مصدر من القائمة" Style="{StaticResource H}" FontSize="19"/>
            <TextBlock x:Name="DetailSubtitle" Style="{StaticResource MutedText}" Margin="0,5,0,12"/>
            <Border Background="#18243B" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="12">
              <StackPanel>
                <TextBlock Text="معلومات التعريب" Foreground="{StaticResource Ink}" FontWeight="Bold"/>
                <TextBlock x:Name="DetailInfo" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>
            <TextBlock Text="طريقة التثبيت" Style="{StaticResource L}" Margin="0,16,0,5"/>
            <TextBlock x:Name="InstallSteps" Foreground="{StaticResource Ink}" TextWrapping="Wrap" LineHeight="22"/>
            <TextBlock Text="ملاحظات مهمة" Style="{StaticResource L}" Margin="0,16,0,5"/>
            <TextBlock x:Name="SafetyNotes" Style="{StaticResource WarnText}"/>
            <Button x:Name="OpenSourceButton" Content="افتح صفحة المصدر الأصلي" Style="{StaticResource PrimaryButton}"
                    Margin="0,18,0,0" IsEnabled="False" Click="OpenSource_Click"/>
            <TextBlock x:Name="SourceAddress" Style="{StaticResource MutedText}" Margin="0,7,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <TextBlock Grid.Row="3" Text="FLAFYO لا يعيد رفع ملفات التعريب دون إذن أصحابها؛ التنزيل يتم من صفحة الفريق أو الموقع الأصلي. افحص الملفات، ولا تشغّل أدوات مجهولة أو تمنحها صلاحيات مسؤول دون سبب موثوق."
               Style="{StaticResource MutedText}" Margin="2,10,2,0"/>
  </Grid>
</Window>