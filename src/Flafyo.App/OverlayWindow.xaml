<Window x:Class="Flafyo.Desktop.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ShowActivated="False" Focusable="False" ResizeMode="NoResize"
        SizeToContent="Height" Width="600" FlowDirection="RightToLeft">
  <Border x:Name="Card" CornerRadius="8" Padding="14,8" BorderThickness="1">
    <StackPanel>
      <TextBlock x:Name="Label" TextWrapping="Wrap"/>
      <TextBlock x:Name="Original" TextWrapping="Wrap" FlowDirection="LeftToRight" Margin="0,6,0,0" Visibility="Collapsed"/>
    </StackPanel>
  </Border>
</Window>
