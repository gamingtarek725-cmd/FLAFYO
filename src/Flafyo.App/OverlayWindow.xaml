<Window x:Class="Flafyo.Desktop.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ShowActivated="False" Focusable="False" ResizeMode="NoResize"
        SizeToContent="Height" Width="620" FlowDirection="RightToLeft">
  <Border x:Name="Card" CornerRadius="25" Padding="16,12" BorderThickness="1"
          SnapsToDevicePixels="True" Background="#F20A0F1B" BorderBrush="#665D789C">
    <StackPanel>
      <Grid MinHeight="44" Margin="0,0,0,1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="88"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Width="36" Height="36" CornerRadius="12" Background="#182B43"
                BorderBrush="#3D668A" BorderThickness="1" VerticalAlignment="Center">
          <TextBlock Text="F" FontSize="22" FontWeight="Black" Foreground="#7DEBFF"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     FlowDirection="LeftToRight"/>
        </Border>
        <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
          <TextBlock Text="FLAFYO ISLAND" FontSize="10" FontWeight="Black"
                     Foreground="#A9BBD4" FlowDirection="LeftToRight"/>
          <TextBlock x:Name="IslandCaption" Text="جاهز للترجمة" FontSize="12"
                     Foreground="#F1F5FF" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <Border x:Name="IslandToggleSlot" Grid.Column="2" Width="82" Height="34"
                Margin="0,0,8,0" Background="Transparent" VerticalAlignment="Center"/>
        <Border Grid.Column="3" MinWidth="76" Background="#172D32" BorderBrush="#286E5D"
                BorderThickness="1" CornerRadius="11" Padding="9,6" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Ellipse x:Name="IslandStatusDot" Width="7" Height="7" Fill="#45E0A0" Margin="0,0,6,0"/>
            <TextBlock x:Name="IslandStatus" Text="LIVE" Foreground="#8CF2C5"
                       FontSize="9" FontWeight="Bold" FlowDirection="LeftToRight"/>
          </StackPanel>
        </Border>
      </Grid>
      <Border x:Name="DetailsPanel" Background="#101A2A" BorderBrush="#2B405D"
              BorderThickness="1" CornerRadius="16" Padding="15,12" Margin="0,12,0,0"
              Visibility="Collapsed">
        <StackPanel>
          <TextBlock x:Name="Label" TextWrapping="Wrap" FontSize="20" MaxWidth="560"
                     MaxHeight="160" Foreground="#FFFFFF" FontWeight="SemiBold"
                     TextAlignment="Right" LineHeight="29"/>
          <Border Height="1" Background="#26364D" Margin="0,10,0,0"
                  Visibility="{Binding Visibility, ElementName=Original}"/>
          <TextBlock x:Name="Original" TextWrapping="Wrap" MaxWidth="560" MaxHeight="56"
                     FlowDirection="LeftToRight" TextAlignment="Left" FontSize="11"
                     Foreground="#A6B4C9" Margin="0,8,0,0" Visibility="Collapsed"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </Border>
</Window>