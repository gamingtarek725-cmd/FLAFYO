<Window x:Class="Flafyo.Desktop.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ShowActivated="False" Focusable="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" MaxWidth="620" FlowDirection="RightToLeft">
  <Border x:Name="Card" CornerRadius="18" Padding="16,12" BorderThickness="1"
          SnapsToDevicePixels="True" Background="#F20A0F1B" BorderBrush="#665D789C">
    <StackPanel>
      <TextBlock x:Name="Label" TextWrapping="Wrap" FontSize="20" MaxWidth="580"
                 Foreground="#FFFFFF" FontWeight="SemiBold" TextAlignment="Right" LineHeight="29"/>
      <TextBlock x:Name="Original" TextWrapping="Wrap" MaxWidth="580"
                 FlowDirection="LeftToRight" TextAlignment="Left" FontSize="11"
                 Foreground="#A6B4C9" Margin="0,8,0,0" Visibility="Collapsed"/>
    </StackPanel>
  </Border>
</Window>