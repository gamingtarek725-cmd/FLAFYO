<Window x:Class="Flafyo.Desktop.IslandControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        Focusable="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight">
  <Button x:Name="ToggleButton" Click="Toggle_Click" Focusable="False" IsTabStop="False"
          Padding="10,5" MinWidth="68" Height="28" FontSize="10" FontWeight="Bold"
          Foreground="#D9FFF1" Background="#163D35" BorderBrush="#347A66"
          BorderThickness="1" Cursor="Hand" ToolTip="تشغيل أو إيقاف الترجمة">
    <Button.Template>
      <ControlTemplate TargetType="Button">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
      </ControlTemplate>
    </Button.Template>
  </Button>
</Window>