<Window x:Class="Flafyo.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FLAFYO GAME TRANSLATOR" Icon="Assets/flafyo.ico" Width="480" Height="1080" ResizeMode="CanMinimize"
        Background="#0E0F14" FlowDirection="RightToLeft" WindowStartupLocation="CenterScreen">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="24">
    <Image Source="Assets/logo.png" Width="150" Height="150" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
    <TextBlock x:Name="StatusText" Text="جاهز" Foreground="White" FontSize="16" Margin="0,18,0,0" TextWrapping="Wrap"/>
    <TextBlock x:Name="EngineText" Text="" Foreground="#FFC857" Margin="0,6,0,0" TextWrapping="Wrap"/>
    <TextBlock x:Name="RegionText" Text="لم يتم اختيار منطقة بعد" Foreground="#9AA0B4" Margin="0,6,0,0"/>
    <TextBlock x:Name="LatencyText" Text="" Foreground="#9AA0B4" Margin="0,6,0,0"/>
    <TextBlock x:Name="LastText" Text="" Foreground="#C9CEE0" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12"/>

    <Button x:Name="SelectButton" Content="١) اختر منطقة النص في اللعبة" Margin="0,20,0,0" Padding="10" FontSize="15" Click="Select_Click"/>

    <Border BorderBrush="#2A2D3A" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,16,0,0">
      <StackPanel>
        <TextBlock Text="الترجمة بدون إنترنت (ذكاء اصطناعي)" Foreground="White" FontWeight="Bold"/>

        <TextBlock x:Name="LightText" Foreground="#9AA0B4" Margin="0,8,0,0" TextWrapping="Wrap"/>
        <Button x:Name="LightButton" Content="تنزيل الحزمة الخفيفة (حوالي 145 ميجا)" Margin="0,6,0,0" Padding="8" Click="Light_Click"/>

        <TextBlock x:Name="HeavyText" Foreground="#9AA0B4" Margin="0,10,0,0" TextWrapping="Wrap"/>
        <Button x:Name="HeavyButton" Content="تنزيل الحزمة التقيلة (حوالي 0.9 جيجا)" Margin="0,6,0,0" Padding="8" Click="Heavy_Click"/>

        <TextBlock Text="الحزمة المستخدمة في الترجمة:" Foreground="White" Margin="0,12,0,4"/>
        <ComboBox x:Name="PackBox" SelectedIndex="0" SelectionChanged="Pack_Changed">
          <ComboBoxItem Content="الخفيفة (أسرع، تناسب أي جهاز)"/>
          <ComboBoxItem Content="التقيلة (أدق في الاصطلاحات، أبطأ وتحتاج جهاز قوي)"/>
        </ComboBox>
        <CheckBox x:Name="MasculineBox" Content="صيغة المذكر في الترجمة" Foreground="White" Margin="0,10,0,0"
                  IsChecked="True" Checked="Masculine_Changed" Unchecked="Masculine_Changed"/>
      </StackPanel>
    </Border>

    <TextBlock Text="سرعة المعالجة:" Foreground="White" Margin="0,16,0,4"/>
    <ComboBox x:Name="SpeedBox" SelectedIndex="1" SelectionChanged="Speed_Changed">
      <ComboBoxItem Content="جهاز ضعيف (أخف)"/>
      <ComboBoxItem Content="متوازن"/>
      <ComboBoxItem Content="أسرع"/>
    </ComboBox>
    <TextBlock Text="حجم النص في اللعبة:" Foreground="White" Margin="0,12,0,4"/>
    <ComboBox x:Name="TextSizeBox" SelectedIndex="1" SelectionChanged="TextSize_Changed">
      <ComboBoxItem Content="كبير وواضح"/>
      <ComboBoxItem Content="عادي"/>
      <ComboBoxItem Content="صغير (تكبير أكتر قبل القراءة)"/>
    </ComboBox>
    <Button x:Name="StartButton" Content="٢) ابدأ الترجمة" Margin="0,16,0,0" Padding="10" FontSize="15" Click="Start_Click"/>
    <Button x:Name="StopButton" Content="إيقاف" Margin="0,8,0,0" Padding="10" FontSize="15" IsEnabled="False" Click="Stop_Click"/>
    <TextBlock x:Name="HotkeyText" Text="اختصار التشغيل/الإيقاف من داخل اللعبة: Ctrl + Alt + T" Foreground="#9AA0B4" Margin="0,12,0,0" FontSize="12" TextWrapping="Wrap"/>
    <Button Content="فتح مجلد القاموس والاصطلاحات" Margin="0,12,0,0" Padding="8" Click="OpenFolder_Click"/>
    <TextBlock Text="الترجمة تظهر في شريط شفاف فوق منطقة النص ولا تمنع الماوس أو الكيبورد. شغّل اللعبة في وضع Windowed أو Borderless."
               Foreground="#9AA0B4" TextWrapping="Wrap" Margin="0,14,0,0" FontSize="12"/>
  </StackPanel>
  </ScrollViewer>
</Window>
