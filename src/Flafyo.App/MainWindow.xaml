<Window x:Class="Flafyo.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FLAFYO GAME TRANSLATOR" Icon="Assets/flafyo.ico" Width="480" Height="760" MinWidth="400" MinHeight="420" ResizeMode="CanResize"
        Background="#0E0F14" FlowDirection="RightToLeft" WindowStartupLocation="CenterScreen">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="24">
    <Image Source="Assets/logo.png" Width="150" Height="150" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
    <TextBlock x:Name="StatusText" Text="جاهز" Foreground="White" FontSize="16" Margin="0,18,0,0" TextWrapping="Wrap"/>
    <TextBlock x:Name="EngineText" Text="" Foreground="#FFC857" Margin="0,6,0,0" TextWrapping="Wrap"/>
    <TextBlock x:Name="RegionText" Text="لم يتم اختيار منطقة بعد" Foreground="#9AA0B4" Margin="0,6,0,0"/>
    <TextBlock x:Name="LatencyText" Text="" Foreground="#9AA0B4" Margin="0,6,0,0"/>
    <TextBlock x:Name="LastText" Text="" Foreground="#C9CEE0" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12"/>

    <Button x:Name="SelectButton" Content="١) اختر منطقة النص في اللعبة" Margin="0,20,0,0" Padding="10" FontSize="15" Click="Select_Click"/>

    <Border BorderBrush="#2A2D3A" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,16,0,0">
      <StackPanel>
        <TextBlock Text="الترجمة بدون إنترنت (ذكاء اصطناعي)" Foreground="White" FontWeight="Bold"/>

        <TextBlock x:Name="LightText" Foreground="#9AA0B4" Margin="0,8,0,0" TextWrapping="Wrap"/>
        <Button x:Name="LightButton" Content="تنزيل الحزمة الخفيفة (حوالي 145 ميجا)" Margin="0,6,0,0" Padding="8" Click="Light_Click"/>

        <TextBlock x:Name="HeavyText" Foreground="#9AA0B4" Margin="0,10,0,0" TextWrapping="Wrap"/>
        <Button x:Name="HeavyButton" Content="تنزيل الحزمة التقيلة (حوالي 0.9 جيجا)" Margin="0,6,0,0" Padding="8" Click="Heavy_Click"/>

        <TextBlock Text="الحزمة المستخدمة في الترجمة:" Foreground="White" Margin="0,12,0,4"/>
        <ComboBox x:Name="PackBox" SelectedIndex="0" SelectionChanged="Pack_Changed">
          <ComboBoxItem Content="الخفيفة (أسرع، تناسب أي جهاز)"/>
          <ComboBoxItem Content="التقيلة (أدق في الاصطلاحات، أبطأ وتحتاج جهاز قوي)"/>
        </ComboBox>
        <CheckBox x:Name="MasculineBox" Content="صيغة المذكر في الترجمة" Foreground="White" Margin="0,10,0,0"
                  IsChecked="True" Checked="Masculine_Changed" Unchecked="Masculine_Changed"/>
        <CheckBox x:Name="PreciseBox" Content="دقة أعلى (أبطأ 2–4 مرات، الحزمة الخفيفة فقط)" Foreground="White" Margin="0,8,0,0"
                  IsChecked="False" Checked="Precise_Changed" Unchecked="Precise_Changed"/>
      </StackPanel>
    </Border>

    <TextBlock Text="سرعة المعالجة:" Foreground="White" Margin="0,16,0,4"/>
    <ComboBox x:Name="SpeedBox" SelectedIndex="1" SelectionChanged="Speed_Changed">
      <ComboBoxItem Content="جهاز ضعيف (أخف)"/>
      <ComboBoxItem Content="متوازن"/>
      <ComboBoxItem Content="أسرع"/>
    </ComboBox>
    <TextBlock Text="حجم النص في اللعبة:" Foreground="White" Margin="0,12,0,4"/>
    <ComboBox x:Name="TextSizeBox" SelectedIndex="1" SelectionChanged="TextSize_Changed">
      <ComboBoxItem Content="كبير وواضح"/>
      <ComboBoxItem Content="عادي"/>
      <ComboBoxItem Content="صغير (تكبير أكتر قبل القراءة)"/>
    </ComboBox>
    <TextBlock Text="وضع الترجمة:" Foreground="White" Margin="0,12,0,4"/>
    <ComboBox x:Name="ModeBox" SelectedIndex="0" SelectionChanged="Mode_Changed">
      <ComboBoxItem Content="منطقة واحدة (حوار أو ترجمة)"/>
      <ComboBoxItem Content="الشاشة كاملة (كل النصوص، كل نص في مستطيل)"/>
    </ComboBox>
    <CheckBox x:Name="ContinuousBox" Content="تحديث مستمر (لو قفلته: اضغط Ctrl+Alt+S وقت ما تحب)" Foreground="White" Margin="0,8,0,0"
              IsChecked="True" Checked="Continuous_Changed" Unchecked="Continuous_Changed"/>
    <TextBlock Text="طريقة التصوير:" Foreground="White" Margin="0,12,0,4"/>
    <ComboBox x:Name="CaptureBox" SelectedIndex="0" SelectionChanged="Capture_Changed">
      <ComboBoxItem Content="عادي (Windowed / Borderless)"/>
      <ComboBoxItem Content="متقدم DXGI (لألعاب Fullscreen والصورة السودة)"/>
    </ComboBox>
    <Button Content="شكل الترجمة: الخط واللون والحجم والمكان" Margin="0,14,0,0" Padding="8" Click="Appearance_Click"/>
    <Button x:Name="StartButton" Content="٢) ابدأ الترجمة" Margin="0,16,0,0" Padding="10" FontSize="15" Click="Start_Click"/>
    <Button x:Name="StopButton" Content="إيقاف" Margin="0,8,0,0" Padding="10" FontSize="15" IsEnabled="False" Click="Stop_Click"/>
    <TextBlock x:Name="HotkeyText" Text="اختصارات داخل اللعبة: Ctrl+Alt+T تشغيل/إيقاف، Ctrl+Alt+S ترجمة الشاشة الآن، Ctrl+Alt+H إخفاء/إظهار المستطيلات، Ctrl+Alt+R قراءة آخر ترجمة بصوت" Foreground="#9AA0B4" Margin="0,12,0,0" FontSize="12" TextWrapping="Wrap"/>
    <TextBlock Text="الشاشة (لوضع الشاشة كاملة):" Foreground="White" Margin="0,12,0,4"/>
    <ComboBox x:Name="MonitorBox" SelectionChanged="Monitor_Changed"/>
    <CheckBox x:Name="SpeakBox" Content="اقرأ الترجمة بصوت عربي (Ctrl+Alt+R يعيد آخر ترجمة)" Foreground="White" Margin="0,10,0,0"
              Checked="Speak_Changed" Unchecked="Speak_Changed"/>
    <TextBlock x:Name="SpeakText" Foreground="#9AA0B4" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>

    <Border BorderBrush="#2A2D3A" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,14,0,0">
      <StackPanel>
        <TextBlock Text="ملف اللعبة (إعدادات لكل لعبة)" Foreground="White" FontWeight="Bold"/>
        <TextBlock x:Name="ProfileText" Foreground="#9AA0B4" Margin="0,6,0,0" TextWrapping="Wrap"/>
        <TextBlock Text="اللعبة الشغالة دلوقتي:" Foreground="White" Margin="0,8,0,4"/>
        <ComboBox x:Name="RunningBox"/>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
          <Button Content="تحديث القايمة" Padding="8,4" Click="RefreshRunning_Click"/>
          <Button Content="احفظ إعداداتي للعبة دي" Padding="8,4" Margin="8,0,0,0" Click="SaveProfile_Click"/>
        </StackPanel>
        <CheckBox x:Name="AutoStartBox" Content="وابدأ الترجمة تلقائي مع اللعبة دي" Foreground="White" Margin="0,8,0,0"/>
        <TextBlock Text="الألعاب المحفوظة:" Foreground="White" Margin="0,10,0,4"/>
        <ComboBox x:Name="ProfileBox"/>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
          <Button Content="تحميل" Padding="10,4" Click="LoadProfile_Click"/>
          <Button Content="حذف" Padding="10,4" Margin="8,0,0,0" Click="DeleteProfile_Click"/>
        </StackPanel>
        <CheckBox x:Name="AutoProfileBox" Content="حمّل إعدادات اللعبة تلقائي لما تفتحها" Foreground="White" Margin="0,10,0,0"
                  IsChecked="True" Checked="AutoProfile_Changed" Unchecked="AutoProfile_Changed"/>
      </StackPanel>
    </Border>

    <Button Content="قواميس جاهزة حسب نوع اللعبة" Margin="0,12,0,0" Padding="8" Click="Glossary_Click"/>
    <Button Content="السجل وتصحيح الترجمة" Margin="0,8,0,0" Padding="8" Click="History_Click"/>
    <Button Content="ترجمة ملفات اللعبة بالذكاء الاصطناعي" Margin="0,12,0,0" Padding="8" Click="GameFiles_Click"/>
    <Button Content="فتح مجلد القاموس والاصطلاحات" Margin="0,12,0,0" Padding="8" Click="OpenFolder_Click"/>
    <TextBlock Text="الترجمة تظهر في شريط شفاف فوق منطقة النص ولا تمنع الماوس أو الكيبورد. شغّل اللعبة في وضع Windowed أو Borderless."
               Foreground="#9AA0B4" TextWrapping="Wrap" Margin="0,14,0,0" FontSize="12"/>
  </StackPanel>
  </ScrollViewer>
</Window>
