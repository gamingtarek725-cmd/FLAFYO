<Window x:Class="Flafyo.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FLAFYO GAME TRANSLATOR" Icon="Assets/flafyo.ico"
        Width="600" Height="820" MinWidth="500" MinHeight="560" ResizeMode="CanResize"
        Background="{StaticResource Page}" FlowDirection="RightToLeft" FontFamily="Segoe UI, Tahoma" FontSize="13"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- header -->
    <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="18,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Image Source="Assets/logo.png" Width="52" Height="52" RenderOptions.BitmapScalingMode="HighQuality"/>
        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
          <TextBlock Text="مترجم الألعاب" FontSize="19" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
          <TextBlock Text="FLAFYO GAME TRANSLATOR" Style="{StaticResource MutedText}" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
        </StackPanel>
        <Border Grid.Column="2" CornerRadius="14" Background="#F0F3F8" Padding="12,5" VerticalAlignment="Center">
          <TextBlock x:Name="StateText" Text="● جاهز" Foreground="{StaticResource Muted}" FontWeight="SemiBold"/>
        </Border>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="18">

        <!-- status + start -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock x:Name="StatusText" Text="جاهز. اختار نوع الترجمة وحدد مكان النص، وبعدين اضغط «ابدأ الترجمة»."
                       FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextWrapping="Wrap"/>
            <TextBlock x:Name="EngineText" Style="{StaticResource WarnText}" Margin="0,6,0,0"/>
            <TextBlock x:Name="LatencyText" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
            <TextBlock x:Name="LastText" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Button x:Name="StartButton" Content="ابدأ الترجمة" Style="{StaticResource PrimaryButton}" Click="Start_Click"/>
              <Button x:Name="StopButton" Grid.Column="1" Content="إيقاف" Margin="10,0,0,0" IsEnabled="False" Click="Stop_Click"/>
            </Grid>
            <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0"
                       Text="اختصار من جوه اللعبة: Ctrl + Alt + T للتشغيل والإيقاف."/>
          </StackPanel>
        </Border>

        <!-- step 1: mode -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="١) اختار نوع الترجمة" Style="{StaticResource H}"/>
            <StackPanel x:Name="ModeRadios" Margin="0,10,0,0">
              <RadioButton x:Name="RegionRadio" GroupName="mode" IsChecked="True" Checked="Mode_Changed">
                <StackPanel Margin="4,0,0,0">
                  <TextBlock Text="منطقة واحدة" FontWeight="SemiBold"/>
                  <TextBlock Text="للحوار أو الترجمة اللي بتظهر في مكان ثابت من الشاشة" Style="{StaticResource MutedText}"/>
                </StackPanel>
              </RadioButton>
              <RadioButton x:Name="ScreenRadio" GroupName="mode" Margin="0,10,0,0" Checked="Mode_Changed">
                <StackPanel Margin="4,0,0,0">
                  <TextBlock Text="الشاشة كاملة" FontWeight="SemiBold"/>
                  <TextBlock Text="كل النصوص اللي على الشاشة، وكل نص يتترجم في مستطيل فوق مكانه" Style="{StaticResource MutedText}"/>
                </StackPanel>
              </RadioButton>
            </StackPanel>
            <Button x:Name="SelectButton" Content="حدد مكان النص على الشاشة (للمنطقة الواحدة)" Margin="0,14,0,0" Click="Select_Click"/>
            <TextBlock x:Name="RegionText" Text="لم يتم اختيار منطقة بعد" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
          </StackPanel>
        </Border>

        <!-- settings tabs -->
        <TabControl Padding="0" Margin="0,0,0,12">

          <TabItem Header="محرك الترجمة">
            <StackPanel Margin="14">
              <TextBlock Text="حزم الترجمة بدون إنترنت" Style="{StaticResource H}"/>
              <TextBlock Text="بتتنزّل مرة واحدة وبعد كده كل حاجة بتشتغل من غير إنترنت." Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
              <TextBlock x:Name="LightText" Style="{StaticResource MutedText}" Margin="0,10,0,0"/>
              <Button x:Name="LightButton" Content="تنزيل الحزمة الخفيفة (حوالي 145 ميجا)" Margin="0,6,0,0" Click="Light_Click"/>
              <TextBlock x:Name="HeavyText" Style="{StaticResource MutedText}" Margin="0,10,0,0"/>
              <Button x:Name="HeavyButton" Content="تنزيل الحزمة التقيلة (حوالي 0.9 جيجا)" Margin="0,6,0,0" Click="Heavy_Click"/>

              <TextBlock Text="الحزمة المستخدمة" Style="{StaticResource L}"/>
              <ComboBox x:Name="PackBox" SelectedIndex="0" SelectionChanged="Pack_Changed">
                <ComboBoxItem Content="الخفيفة: أسرع وتناسب أي جهاز"/>
                <ComboBoxItem Content="التقيلة: أدق في الاصطلاحات، أبطأ وتحتاج جهاز قوي"/>
              </ComboBox>
              <CheckBox x:Name="MasculineBox" Content="صيغة المذكر في الترجمة" IsChecked="True" Checked="Masculine_Changed" Unchecked="Masculine_Changed"/>
              <CheckBox x:Name="PreciseBox" Content="دقة أعلى (أبطأ 2 لـ 4 مرات، للحزمة الخفيفة)" IsChecked="False" Checked="Precise_Changed" Unchecked="Precise_Changed"/>

              <TextBlock Text="سرعة المعالجة" Style="{StaticResource L}"/>
              <ComboBox x:Name="SpeedBox" SelectedIndex="1" SelectionChanged="Speed_Changed">
                <ComboBoxItem Content="جهاز ضعيف (أخف)"/>
                <ComboBoxItem Content="متوازن"/>
                <ComboBoxItem Content="أسرع"/>
              </ComboBox>
              <TextBlock Text="حجم النص في اللعبة" Style="{StaticResource L}"/>
              <ComboBox x:Name="TextSizeBox" SelectedIndex="1" SelectionChanged="TextSize_Changed">
                <ComboBoxItem Content="كبير وواضح"/>
                <ComboBoxItem Content="عادي"/>
                <ComboBoxItem Content="صغير (تكبير أكتر قبل القراءة)"/>
              </ComboBox>

              <Button Content="قواميس جاهزة حسب نوع اللعبة" Margin="0,16,0,0" Click="Glossary_Click"/>
              <Button Content="فتح مجلد القاموس والاصطلاحات" Margin="0,8,0,0" Click="OpenFolder_Click"/>
            </StackPanel>
          </TabItem>

          <TabItem Header="التصوير والشاشة">
            <StackPanel Margin="14">
              <TextBlock Text="طريقة التصوير" Style="{StaticResource L}" Margin="0,0,0,4"/>
              <ComboBox x:Name="CaptureBox" SelectedIndex="0" SelectionChanged="Capture_Changed">
                <ComboBoxItem Content="عادي (Windowed / Borderless)"/>
                <ComboBoxItem Content="متقدم DXGI (لألعاب Fullscreen والصورة السودة)"/>
              </ComboBox>
              <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                         Text="لو لعبتك Fullscreen والترجمة مش بتظهر أو الصورة سودة: جرّب «متقدم»."/>
              <TextBlock Text="الشاشة (لوضع الشاشة كاملة)" Style="{StaticResource L}"/>
              <ComboBox x:Name="MonitorBox" SelectionChanged="Monitor_Changed"/>
              <CheckBox x:Name="ContinuousBox" Content="تحديث مستمر (لو قفلته: الترجمة بتحصل لما تضغط الاختصار بس)" IsChecked="True"
                        Checked="Continuous_Changed" Unchecked="Continuous_Changed"/>
              <Border Style="{StaticResource Card}" Margin="0,16,0,0" Background="#F8FAFF">
                <StackPanel>
                  <TextBlock Text="لألعاب Fullscreen: شاشة كاملة بدون حدود" Style="{StaticResource H}"/>
                  <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                             Text="Windows مبتسمحش لأي برنامج يرسم فوق لعبة Fullscreen الحصري أو يصوّرها. الحل: 1) شغّل اللعبة Windowed من إعداداتها. 2) اختارها هنا واضغط «حوّلها». هتبان Fullscreen كاملة، والترجمة هتشتغل (حتى لو اخترت جزء من الشاشة بس)."/>
                  <TextBlock Text="اللعبة" Style="{StaticResource L}"/>
                  <ComboBox x:Name="BorderlessBox"/>
                  <WrapPanel Margin="0,8,0,0">
                    <Button Content="تحديث القايمة" Margin="0,0,8,0" Click="RefreshBorderless_Click"/>
                    <Button Content="حوّلها لشاشة كاملة" Margin="0,0,8,0" Click="Borderless_Click"/>
                    <Button Content="رجّعها زي ما كانت" Click="BorderlessRestore_Click"/>
                  </WrapPanel>
                  <TextBlock x:Name="BorderlessText" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
                  <TextBlock Style="{StaticResource WarnText}" Margin="0,6,0,0"
                             Text="للألعاب الفردية. الألعاب الأونلاين اللي عليها حماية ممكن تعتبر ده تعديل. بعض الألعاب بترجّع شكلها لوحدها: كرّر الضغط."/>
                </StackPanel>
              </Border>
              <TextBlock x:Name="HotkeyText" Style="{StaticResource MutedText}" Margin="0,12,0,0"
                         Text="اختصارات من جوه اللعبة:&#10;Ctrl+Alt+T تشغيل / إيقاف&#10;Ctrl+Alt+S ترجمة الشاشة الآن&#10;Ctrl+Alt+H إخفاء / إظهار المستطيلات&#10;Ctrl+Alt+R قراءة آخر ترجمة بصوت"/>

              <Border Style="{StaticResource Card}" Margin="0,18,0,0" Background="#F7FAFF">
                <StackPanel>
                  <TextBlock Text="ألعاب Fullscreen: شاشة كاملة بدون حدود" Style="{StaticResource H}"/>
                  <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                             Text="Windows مبتسمحش لأي برنامج يرسم الترجمة فوق Fullscreen الحصري. الحل: شغّل اللعبة Windowed من إعداداتها، وبعدين حوّلها من هنا لشاشة كاملة بدون حدود. هتبان Fullscreen بالظبط، والترجمة بتشتغل (وتقدر تختار جزء من الشاشة)."/>
                  <TextBlock Text="اللعبة الشغالة دلوقتي" Style="{StaticResource L}"/>
                  <ComboBox x:Name="BorderlessBox"/>
                  <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="تحديث القايمة" Click="RefreshBorderless_Click"/>
                    <Button Content="حوّلها لشاشة كاملة" Margin="8,0,0,0" Click="Borderless_Click"/>
                    <Button Content="رجّعها زي ما كانت" Margin="8,0,0,0" Click="BorderlessRestore_Click"/>
                  </StackPanel>
                  <TextBlock x:Name="BorderlessText" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                  <TextBlock Style="{StaticResource WarnText}" Margin="0,4,0,0"
                             Text="للألعاب الفردية. في الألعاب الأونلاين اللي عليها حماية، تغيير شكل نافذة اللعبة ممكن يتعارض معاها."/>
                </StackPanel>
              </Border>
            </StackPanel>
          </TabItem>

          <TabItem Header="الشكل والصوت">
            <StackPanel Margin="14">
              <TextBlock Text="شكل الترجمة" Style="{StaticResource H}"/>
              <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,0"
                         Text="غيّر الخط واللون والحجم ومكان الشريط. كل تغيير بيظهر فورًا في معاينة."/>
              <Button Content="تغيير شكل الترجمة" Margin="0,10,0,0" Click="Appearance_Click"/>

              <TextBlock Text="الصوت" Style="{StaticResource L}" Margin="0,18,0,4"/>
              <CheckBox x:Name="SpeakBox" Content="اقرأ الترجمة بصوت عربي" Checked="Speak_Changed" Unchecked="Speak_Changed" Margin="0"/>
              <TextBlock x:Name="SpeakText" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>

              <TextBlock Text="السجل والتصحيح" Style="{StaticResource L}" Margin="0,18,0,4"/>
              <Button Content="السجل وتصحيح الترجمة" Click="History_Click"/>
            </StackPanel>
          </TabItem>

          <TabItem Header="الألعاب والملفات">
            <StackPanel Margin="14">
              <TextBlock Text="إعدادات لكل لعبة" Style="{StaticResource H}"/>
              <TextBlock x:Name="ProfileText" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
              <TextBlock Text="اللعبة الشغالة دلوقتي" Style="{StaticResource L}"/>
              <ComboBox x:Name="RunningBox"/>
              <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button Content="تحديث القايمة" Click="RefreshRunning_Click"/>
                <Button Grid.Column="1" Content="احفظ إعداداتي للعبة دي" Margin="8,0,0,0" Click="SaveProfile_Click"/>
              </Grid>
              <CheckBox x:Name="AutoStartBox" Content="وابدأ الترجمة تلقائي مع اللعبة دي"/>
              <TextBlock Text="الألعاب المحفوظة" Style="{StaticResource L}"/>
              <ComboBox x:Name="ProfileBox"/>
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="تحميل" Click="LoadProfile_Click"/>
                <Button Content="حذف" Margin="8,0,0,0" Click="DeleteProfile_Click"/>
              </StackPanel>
              <CheckBox x:Name="AutoProfileBox" Content="حمّل إعدادات اللعبة تلقائي لما تفتحها" IsChecked="True"
                        Checked="AutoProfile_Changed" Unchecked="AutoProfile_Changed"/>

              <TextBlock Text="ملفات اللعبة" Style="{StaticResource L}" Margin="0,20,0,4"/>
              <Button Content="ترجمة ملفات اللعبة بالذكاء الاصطناعي" Click="GameFiles_Click"/>

              <TextBlock Text="مشاكل؟" Style="{StaticResource L}" Margin="0,20,0,4"/>
              <Button Content="فتح سجل الأخطاء" Click="OpenLog_Click"/>
            </StackPanel>
          </TabItem>
        </TabControl>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
