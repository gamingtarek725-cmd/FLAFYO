<Window x:Class="Flafyo.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Flafyo.Desktop"
        Title="FLAFYO GAME TRANSLATOR" Icon="Assets/flafyo.ico"
        Width="1440" Height="920" MinWidth="1120" MinHeight="720"
        Background="{StaticResource Page}" FlowDirection="RightToLeft"
        FontFamily="Segoe UI, Tahoma" FontSize="13" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="HorizontalContentAlignment" Value="Right"/>
      <Setter Property="Padding" Value="16,13"/>
      <Setter Property="Margin" Value="0,4"/>
      <Setter Property="Background" Value="#121C31"/>
      <Setter Property="BorderBrush" Value="#243654"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style x:Key="HeroTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#F7F8FF"/>
      <Setter Property="FontSize" Value="30"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#F7F8FF"/>
      <Setter Property="FontSize" Value="19"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="252"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/></Grid.RowDefinitions>

    <!-- Permanent navigation: each destination appears once. -->
    <Border Grid.Column="0" Grid.RowSpan="2" Background="#090E1B" BorderBrush="#202B45" BorderThickness="0,0,1,0" Padding="18,20">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top">
          <Border Background="#141F36" BorderBrush="#293B5B" BorderThickness="1" CornerRadius="18" Padding="14" Margin="0,0,0,28">
            <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
              <Image Source="Assets/logo.png" Width="46" Height="46" Stretch="Uniform" Margin="0,0,12,0"/>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="FLAFYO" FontSize="23" FontWeight="Bold" Foreground="#A78BFA"/>
                <TextBlock Text="GAME TRANSLATOR" FontSize="9" Foreground="#91A2C4" FontWeight="Bold"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <TextBlock Text="مساحة العمل" Foreground="#7182A5" FontSize="10" FontWeight="Bold" Margin="4,0,0,9"/>
          <Button Style="{StaticResource NavButton}" Content="⌂   الرئيسية" Click="DashboardHome_Click"/>
          <Button Style="{StaticResource NavButton}" Content="◉   الترجمة الفورية" Click="NavigateLive_Click"/>
          <Button Style="{StaticResource NavButton}" Content="▤   تعريب ملفات الألعاب" Click="DashboardFiles_Click"/>
          <Button Style="{StaticResource NavButton}" Content="▦   مكتبة التعريبات" Click="DashboardLibrary_Click"/>
          <Button Style="{StaticResource NavButton}" Content="文   حزم اللغات" Click="DashboardLanguages_Click"/>
          <Button Style="{StaticResource NavButton}" Content="⌘   ملفات تعريف الألعاب" Click="DashboardGameSettings_Click"/>
          <Separator Margin="0,17"/>
          <TextBlock Text="الأدوات" Foreground="#7182A5" FontSize="10" FontWeight="Bold" Margin="4,0,0,9"/>
          <Button Style="{StaticResource NavButton}" Content="✦   مظهر الترجمة" Click="Appearance_Click"/>
          <Button Style="{StaticResource NavButton}" Content="◷   سجل الترجمة" Click="History_Click"/>
          <Button Style="{StaticResource NavButton}" Content="⌕   قواميس الألعاب" Click="Glossary_Click"/>
          <Button Style="{StaticResource NavButton}" Content="⚙   التشخيص والسجلات" Click="DashboardLogs_Click"/>
        </StackPanel>
        <Border DockPanel.Dock="Bottom" Background="#101A2D" BorderBrush="#263956" BorderThickness="1" CornerRadius="14" Padding="13" Margin="0,18,0,0">
          <StackPanel>
            <TextBlock Text="حالة التطبيق" Foreground="#8293B5" FontSize="10"/>
            <TextBlock x:Name="StateText" Text="● جاهز" Foreground="#34D399" FontWeight="Bold" Margin="0,7,0,2"/>
            <TextBlock Text="المعالجة المحلية · Windows" Foreground="#8293B5" FontSize="10"/>
          </StackPanel>
        </Border>
      </DockPanel>
    </Border>

    <!-- Top command bar -->
    <Border Grid.Column="1" Grid.Row="0" Background="#0D1425" BorderBrush="#202B45" BorderThickness="0,0,0,1" Padding="24,10">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="مترجم الألعاب" FontSize="19" FontWeight="Bold" Foreground="#F7F8FF"/>
          <TextBlock Text="ترجمة الألعاب وتعريبها — مساحة عمل موحّدة" Foreground="#8E9DB9" FontSize="11" Margin="0,3,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="UpdateStatusText" Text="الإصدار" Foreground="#9AA4BD" VerticalAlignment="Center" Margin="0,0,14,0"/>
          <Button x:Name="CheckUpdatesButton" Content="التحقق من التحديثات" Click="CheckUpdates_Click" Padding="14,9"/>
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer x:Name="MainScrollViewer" Grid.Column="1" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <TabControl x:Name="MainTabs" Background="Transparent" BorderThickness="0" Padding="0">
        <TabControl.Template>
          <ControlTemplate TargetType="TabControl">
            <ContentPresenter ContentSource="SelectedContent"/>
          </ControlTemplate>
        </TabControl.Template>

        <!-- HOME -->
        <TabItem Header="الرئيسية">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28">
              <Border CornerRadius="22" Padding="30" Margin="0,0,0,18" BorderBrush="#38436D" BorderThickness="1">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#25204A" Offset="0"/>
                    <GradientStop Color="#14243A" Offset="0.58"/>
                    <GradientStop Color="#101829" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="FLAFYO  /  GAME TRANSLATOR" Foreground="#7CE8F6" FontSize="10" FontWeight="Bold" FlowDirection="LeftToRight"/>
                    <TextBlock Text="خلّي عالم اللعبة بلغتك." Style="{StaticResource HeroTitle}" Margin="0,10,0,5"/>
                    <TextBlock Text="ترجمة فورية فوق اللعبة، تعريب ملفات، ومكتبة تعريبات في مكان واحد." Foreground="#C0CBE0" FontSize="14" TextWrapping="Wrap" MaxWidth="650"/>
                    <Button Content="ابدأ الترجمة الفورية  ←" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="0,22,0,0" Click="NavigateLive_Click"/>
                  </StackPanel>
                  <Border Grid.Column="1" Width="118" Height="118" CornerRadius="28" Background="#1A2945" BorderBrush="#4B5E91" BorderThickness="1" Padding="18" VerticalAlignment="Center">
                    <Image Source="Assets/logo.png" Stretch="Uniform"/>
                  </Border>
                </Grid>
              </Border>

              <TextBlock Text="نظرة عامة" Style="{StaticResource SectionTitle}"/>
              <UniformGrid Columns="3" Margin="0,0,0,18">
                <Border Background="#111B30" BorderBrush="#263956" BorderThickness="1" CornerRadius="15" Padding="17" Margin="0,0,10,0">
                  <StackPanel><TextBlock Text="محرك الترجمة" Foreground="#8EA0C2"/><TextBlock x:Name="DashboardEngineStatus" Text="OCR · Offline · Overlay" Foreground="#F7F8FF" FontSize="14" FontWeight="SemiBold" Margin="0,9,0,0"/><TextBlock Text="حالة المحرك" Foreground="#7182A5" FontSize="10" Margin="0,4,0,0"/></StackPanel>
                </Border>
                <Border Background="#111B30" BorderBrush="#263956" BorderThickness="1" CornerRadius="15" Padding="17" Margin="5,0">
                  <StackPanel><TextBlock Text="حالة الجلسة" Foreground="#8EA0C2"/><TextBlock x:Name="DashboardState" Text="جاهز" Foreground="#34D399" FontSize="17" FontWeight="Bold" Margin="0,9,0,0"/><TextBlock Text="ابدأ أو أوقف الترجمة من صفحة الترجمة" Foreground="#7182A5" FontSize="10" Margin="0,4,0,0"/></StackPanel>
                </Border>
                <Border Background="#111B30" BorderBrush="#263956" BorderThickness="1" CornerRadius="15" Padding="17" Margin="10,0,0,0">
                  <StackPanel><TextBlock Text="اختصار سريع" Foreground="#8EA0C2"/><TextBlock Text="CTRL  +  ALT  +  T" Foreground="#7CE8F6" FontSize="16" FontWeight="Bold" Margin="0,9,0,0" FlowDirection="LeftToRight"/><TextBlock Text="تشغيل / إيقاف أثناء اللعب" Foreground="#7182A5" FontSize="10" Margin="0,4,0,0"/></StackPanel>
                </Border>
              </UniformGrid>

              <TextBlock Text="أدوات FLAFYO" Style="{StaticResource SectionTitle}"/>
              <UniformGrid Columns="3">
                <Border Background="#111B30" BorderBrush="#263956" BorderThickness="1" CornerRadius="15" Padding="17" Margin="0,0,8,0">
                  <StackPanel><TextBlock Text="01  /  LIVE OCR" Foreground="#7CE8F6" FontSize="10" FontWeight="Bold" FlowDirection="LeftToRight"/><TextBlock Text="التقاط النصوص وترجمتها فوق اللعبة" Foreground="#F7F8FF" FontWeight="SemiBold" Margin="0,9,0,0" TextWrapping="Wrap"/></StackPanel>
                </Border>
                <Border Background="#111B30" BorderBrush="#263956" BorderThickness="1" CornerRadius="15" Padding="17" Margin="4,0">
                  <StackPanel><TextBlock Text="02  /  OFFLINE" Foreground="#A78BFA" FontSize="10" FontWeight="Bold" FlowDirection="LeftToRight"/><TextBlock Text="حزم ترجمة محلية تعمل دون اتصال" Foreground="#F7F8FF" FontWeight="SemiBold" Margin="0,9,0,0" TextWrapping="Wrap"/></StackPanel>
                </Border>
                <Border Background="#111B30" BorderBrush="#263956" BorderThickness="1" CornerRadius="15" Padding="17" Margin="8,0,0,0">
                  <StackPanel><TextBlock Text="03  /  GAME LIBRARY" Foreground="#7CE8F6" FontSize="10" FontWeight="Bold" FlowDirection="LeftToRight"/><TextBlock Text="مكتبة تعريبات مع صور الألعاب ومعلومات المصدر" Foreground="#F7F8FF" FontWeight="SemiBold" Margin="0,9,0,0" TextWrapping="Wrap"/></StackPanel>
                </Border>
              </UniformGrid>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- LIVE TRANSLATION -->
        <TabItem Header="الترجمة الفورية">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28" MaxWidth="920" HorizontalAlignment="Right">
              <TextBlock Text="الترجمة الفورية" Style="{StaticResource HeroTitle}"/>
              <TextBlock Text="حدد مصدر النص وطريقة التقاطه، ثم شغّل الترجمة. لن تتوقف اللعبة أثناء المعالجة." Foreground="#9AAAC7" FontSize="13" Margin="0,8,0,22" TextWrapping="Wrap"/>
              <Border Background="#111A30" BorderBrush="#293B5A" BorderThickness="1" CornerRadius="18" Padding="22" Margin="0,0,0,16">
                <StackPanel>
                  <TextBlock Text="طريقة الالتقاط" Style="{StaticResource SectionTitle}"/>
                  <StackPanel x:Name="ModeRadios" Margin="0,10,0,0">
                    <RadioButton x:Name="RegionRadio" GroupName="mode" IsChecked="True" Checked="Mode_Changed">
                      <StackPanel Margin="4,0,0,0"><TextBlock Text="منطقة محددة" FontWeight="SemiBold"/><TextBlock Text="للحوار أو النصوص التي تظهر في مكان ثابت" Foreground="#9AA4BD" Margin="0,3,0,0"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ScreenRadio" GroupName="mode" Margin="0,12,0,0" Checked="Mode_Changed">
                      <StackPanel Margin="4,0,0,0"><TextBlock Text="الشاشة كاملة" FontWeight="SemiBold"/><TextBlock Text="اكتشاف النصوص الظاهرة وترجمتها فوق مواضعها" Foreground="#9AA4BD" Margin="0,3,0,0"/></StackPanel>
                    </RadioButton>
                  </StackPanel>
                  <Button x:Name="SelectButton" Content="تحديد منطقة النص" Margin="0,18,0,0" Click="Select_Click" HorizontalAlignment="Right"/>
                  <TextBlock x:Name="RegionText" Text="لم يتم اختيار منطقة بعد" Foreground="#91A2C4" Margin="0,8,0,0"/>
                </StackPanel>
              </Border>
              <Border Background="#111A30" BorderBrush="#293B5A" BorderThickness="1" CornerRadius="18" Padding="22">
                <StackPanel>
                  <TextBlock Text="حالة جلسة الترجمة" Style="{StaticResource SectionTitle}"/>
                  <TextBlock x:Name="StatusText" Text="جاهز. حدد مكان النص ثم ابدأ الترجمة." Foreground="#F7F8FF" FontSize="15" TextWrapping="Wrap"/>
                  <TextBlock x:Name="EngineText" Style="{StaticResource WarnText}" Margin="0,8,0,0"/>
                  <TextBlock x:Name="LatencyText" Style="{StaticResource MutedText}" Margin="0,5,0,0"/>
                  <TextBlock x:Name="LastText" Style="{StaticResource MutedText}" Margin="0,5,0,0"/>
                  <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button x:Name="StartButton" Content="ابدأ الترجمة" Style="{StaticResource PrimaryButton}" Click="Start_Click"/>
                    <Button x:Name="StopButton" Grid.Column="1" Content="إيقاف" Margin="10,0,0,0" IsEnabled="False" Click="Stop_Click"/>
                  </Grid>
                  <TextBlock Text="اختصار التشغيل والإيقاف: Ctrl + Alt + T" Foreground="#91A2C4" Margin="0,12,0,0" FlowDirection="RightToLeft"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- SETTINGS -->
        <TabItem Header="الإعدادات">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28">
              <TextBlock Text="مركز الإعدادات" Style="{StaticResource HeroTitle}" Margin="0,0,0,8"/>
              <TextBlock Text="كل إعداد في قسم واضح. لا توجد قوائم مكررة أو حقول متداخلة." Foreground="#9AAAC7" Margin="0,0,0,18"/>
              <TabControl x:Name="SettingsTabs" Padding="0" Margin="0,0,0,12">

          <TabItem Header="محرك الترجمة">
            <StackPanel Margin="14">
              <TextBlock Text="حزم الترجمة بدون إنترنت" Style="{StaticResource H}"/>
              <TextBlock Text="بتتنزّل مرة واحدة وبعد كده كل حاجة بتشتغل من غير إنترنت." Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
              <TextBlock x:Name="LightText" Style="{StaticResource MutedText}" Margin="0,10,0,0"/>
              <Button x:Name="LightButton" Content="تنزيل الحزمة الخفيفة (حوالي 145 ميجا)" Margin="0,6,0,0" Click="Light_Click"/>
              <TextBlock x:Name="HeavyText" Style="{StaticResource MutedText}" Margin="0,10,0,0"/>
              <Button x:Name="HeavyButton" Content="تنزيل الحزمة التقيلة (حوالي 0.9 جيجا)" Margin="0,6,0,0" Click="Heavy_Click"/>
              <TextBlock x:Name="MadladText" Style="{StaticResource MutedText}" Margin="0,10,0,0"/>
              <Button x:Name="MadladButton" Content="MADLAD-400 3B — متوقف مؤقتًا" Margin="0,6,0,0" IsEnabled="False" Click="Madlad_Click"/>
              <TextBlock Text="تنبيه: الحزمة الأكبر تحتاج مساحة وتنزيلًا كبيرًا، وقد تكون أبطأ وتستهلك ذاكرة ومعالجًا أكثر أثناء اللعب." Style="{StaticResource MutedText}" Margin="0,4,0,8" TextWrapping="Wrap"/>

              <TextBlock Text="الحزمة المستخدمة" Style="{StaticResource L}"/>
              <ComboBox x:Name="PackBox" SelectedIndex="0" SelectionChanged="Pack_Changed">
                <ComboBoxItem Content="الخفيفة: أسرع وتناسب الأجهزة الضعيفة"/>
                <ComboBoxItem Content="التقيلة NLLB-600M: توازن بين الحجم والتنوع"/>
                <ComboBoxItem Content="MADLAD-400 3B: غير متاح حاليًا لحين دمج بنية ONNX متوافقة واختبارها"/>
              </ComboBox>
              <CheckBox x:Name="MasculineBox" Content="صيغة المذكر في الترجمة" IsChecked="True" Checked="Masculine_Changed" Unchecked="Masculine_Changed"/>
              <CheckBox x:Name="PreciseBox" Content="دقة أعلى (أبطأ 2 لـ 4 مرات، للحزمة الخفيفة)" IsChecked="False" Checked="Precise_Changed" Unchecked="Precise_Changed"/>
              <CheckBox x:Name="TranslateBrandsBox" Content="ترجمة الشعارات والعلامات التجارية" IsChecked="False" Checked="TranslateBrands_Changed" Unchecked="TranslateBrands_Changed" Margin="0,8,0,0"/>
              <TextBlock Text="عند التفعيل، يستخدم قاموسًا لأسماء العلامات التجارية المعروفة وتجربة OCR إضافية عالية التباين عند الحاجة. قد تزيد المعالجة قليلًا، ولا يضمن قراءة الشعارات المرسومة بلا حروف واضحة." Style="{StaticResource MutedText}" Margin="22,2,0,0" TextWrapping="Wrap"/>

              <TextBlock Text="سرعة المعالجة" Style="{StaticResource L}"/>
              <ComboBox x:Name="SpeedBox" SelectedIndex="1" SelectionChanged="Speed_Changed">
                <ComboBoxItem Content="جهاز ضعيف (أخف)"/>
                <ComboBoxItem Content="متوازن"/>
                <ComboBoxItem Content="أسرع"/>
              </ComboBox>
              <TextBlock Text="حجم النص في اللعبة" Style="{StaticResource L}"/>
              <ComboBox x:Name="TextSizeBox" SelectedIndex="1" SelectionChanged="TextSize_Changed">
                <ComboBoxItem Content="كبير وواضح"/>
                <ComboBoxItem Content="عادي"/>
                <ComboBoxItem Content="صغير (تكبير أكتر قبل القراءة)"/>
              </ComboBox>

              <Border Style="{StaticResource Card}" Margin="0,16,0,0" Background="#1B1D35">
                <StackPanel>
                  <TextBlock Text="أو: ترجمة بحسابك الخاص في موقع ذكاء اصطناعي" Style="{StaticResource H}"/>
                  <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                             Text="بدل الحزمتين فوق، تقدر تستخدم مفتاح API بتاعك من OpenAI أو أي خدمة متوافقة معاها، أو من Anthropic (Claude). المفتاح بيتحفظ على جهازك بس، ومش بيروح لحد غير الموقع اللي اخترته، وهتدفع حسب استخدامك في حسابك هناك."/>
                  <TextBlock Text="الخدمة" Style="{StaticResource L}"/>
                  <ComboBox x:Name="AiProviderBox" SelectedIndex="0" SelectionChanged="AiSetting_Changed">
                    <ComboBoxItem Content="OpenAI أو خدمة متوافقة معاها"/>
                    <ComboBoxItem Content="Anthropic (Claude)"/>
                  </ComboBox>
                  <TextBlock Text="مفتاح API" Style="{StaticResource L}"/>
                  <PasswordBox x:Name="AiKeyBox" Padding="7" PasswordChanged="AiSetting_Changed"/>
                  <TextBlock Text="اسم النموذج (مثال: gpt-4o-mini أو claude-3-5-sonnet-latest)" Style="{StaticResource L}"/>
                  <TextBox x:Name="AiModelBox" Padding="7" TextChanged="AiSetting_Changed"/>
                  <TextBlock Text="رابط مخصص (اختياري، لخدمة متوافقة مع OpenAI غير openai.com نفسها)" Style="{StaticResource L}"/>
                  <TextBox x:Name="AiUrlBox" Padding="7" TextChanged="AiSetting_Changed"/>
                  <Button Content="اربط الحساب واختبر الاتصال" Margin="0,10,0,0" Click="AiTest_Click"/>
                  <TextBlock x:Name="AiStatusText" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
                  <CheckBox x:Name="UseAiBox" Content="استخدم حساب الذكاء الاصطناعي ده بدل الحزمتين فوق" Margin="0,10,0,0"
                            Checked="UseAi_Changed" Unchecked="UseAi_Changed"/>
                </StackPanel>
              </Border>

              <Button Content="قواميس جاهزة حسب نوع اللعبة" Margin="0,16,0,0" Click="Glossary_Click"/>
              <Button Content="فتح مجلد القاموس والاصطلاحات" Margin="0,8,0,0" Click="OpenFolder_Click"/>
            </StackPanel>
          </TabItem>

          <TabItem Header="التصوير والشاشة">
            <StackPanel Margin="14">
              <TextBlock Text="طريقة التصوير" Style="{StaticResource L}" Margin="0,0,0,4"/>
              <ComboBox x:Name="CaptureBox" SelectedIndex="0" SelectionChanged="Capture_Changed">
                <ComboBoxItem Content="عادي (Windowed / Borderless)"/>
                <ComboBoxItem Content="متقدم DXGI (لألعاب Fullscreen والصورة السودة)"/>
              </ComboBox>
              <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                         Text="لو لعبتك Fullscreen والترجمة مش بتظهر أو الصورة سودة: جرّب «متقدم»."/>
              <TextBlock Text="الشاشة (لوضع الشاشة كاملة)" Style="{StaticResource L}"/>
              <ComboBox x:Name="MonitorBox" SelectionChanged="Monitor_Changed"/>
              <CheckBox x:Name="ContinuousBox" Content="تحديث مستمر (لو قفلته: الترجمة بتحصل لما تضغط الاختصار بس)" IsChecked="True"
                        Checked="Continuous_Changed" Unchecked="Continuous_Changed"/>
              <Border Style="{StaticResource Card}" Margin="0,16,0,0" Background="#17233A">
                <StackPanel>
                  <TextBlock Text="لألعاب Fullscreen: شاشة كاملة بدون حدود" Style="{StaticResource H}"/>
                  <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                             Text="Windows مبتسمحش لأي برنامج يرسم فوق لعبة Fullscreen الحصري أو يصوّرها. الحل: 1) شغّل اللعبة Windowed من إعداداتها. 2) اختارها هنا واضغط «حوّلها». هتبان Fullscreen كاملة، والترجمة هتشتغل (حتى لو اخترت جزء من الشاشة بس)."/>
                  <TextBlock Text="اللعبة" Style="{StaticResource L}"/>
                  <ComboBox x:Name="BorderlessBox"/>
                  <WrapPanel Margin="0,8,0,0">
                    <Button Content="تحديث القايمة" Margin="0,0,8,0" Click="RefreshBorderless_Click"/>
                    <Button Content="حوّلها لشاشة كاملة" Margin="0,0,8,0" Click="Borderless_Click"/>
                    <Button Content="رجّعها زي ما كانت" Click="BorderlessRestore_Click"/>
                  </WrapPanel>
                  <TextBlock x:Name="BorderlessText" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
                  <TextBlock Style="{StaticResource WarnText}" Margin="0,6,0,0"
                             Text="للألعاب الفردية. الألعاب الأونلاين اللي عليها حماية ممكن تعتبر ده تعديل. بعض الألعاب بترجّع شكلها لوحدها: كرّر الضغط."/>
                </StackPanel>
              </Border>
              <TextBlock x:Name="HotkeyText" Style="{StaticResource MutedText}" Margin="0,12,0,0"
                         Text="اختصارات من جوه اللعبة:&#10;Ctrl+Alt+T تشغيل / إيقاف&#10;Ctrl+Alt+S ترجمة الشاشة الآن&#10;Ctrl+Alt+H إخفاء / إظهار المستطيلات&#10;Ctrl+Alt+R قراءة آخر ترجمة بصوت"/>

            </StackPanel>
          </TabItem>

          <TabItem Header="الشكل والصوت">
            <StackPanel Margin="14">
              <TextBlock Text="شكل الترجمة" Style="{StaticResource H}"/>
              <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,0"
                         Text="غيّر الخط واللون والحجم ومكان الشريط. كل تغيير بيظهر فورًا في معاينة."/>
              <Button Content="تغيير شكل الترجمة" Margin="0,10,0,0" Click="Appearance_Click"/>

              <TextBlock Text="الصوت" Style="{StaticResource L}" Margin="0,18,0,4"/>
              <CheckBox x:Name="SpeakBox" Content="اقرأ الترجمة بصوت عربي" Checked="Speak_Changed" Unchecked="Speak_Changed" Margin="0"/>
              <TextBlock x:Name="SpeakText" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>

              <TextBlock Text="السجل والتصحيح" Style="{StaticResource L}" Margin="0,18,0,4"/>
              <Button Content="السجل وتصحيح الترجمة" Click="History_Click"/>
            </StackPanel>
          </TabItem>

          <TabItem Header="الألعاب والملفات">
            <StackPanel Margin="14">
              <TextBlock Text="إعدادات لكل لعبة" Style="{StaticResource H}"/>
              <TextBlock x:Name="ProfileText" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
              <TextBlock Text="اللعبة الشغالة دلوقتي" Style="{StaticResource L}"/>
              <ComboBox x:Name="RunningBox"/>
              <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button Content="تحديث القايمة" Click="RefreshRunning_Click"/>
                <Button Grid.Column="1" Content="احفظ إعداداتي للعبة دي" Margin="8,0,0,0" Click="SaveProfile_Click"/>
              </Grid>
              <CheckBox x:Name="AutoStartBox" Content="وابدأ الترجمة تلقائي مع اللعبة دي"/>
              <TextBlock Text="الألعاب المحفوظة" Style="{StaticResource L}"/>
              <ComboBox x:Name="ProfileBox"/>
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="تحميل" Click="LoadProfile_Click"/>
                <Button Content="حذف" Margin="8,0,0,0" Click="DeleteProfile_Click"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="تصدير الإعدادات" Click="ExportProfile_Click"/>
                <Button Content="استيراد إعدادات" Margin="8,0,0,0" Click="ImportProfile_Click"/>
              </StackPanel>
              <CheckBox x:Name="AutoProfileBox" Content="حمّل إعدادات اللعبة تلقائي لما تفتحها" IsChecked="True"
                        Checked="AutoProfile_Changed" Unchecked="AutoProfile_Changed"/>

              <TextBlock Text="ملفات اللعبة" Style="{StaticResource L}" Margin="0,20,0,4"/>
              <Button Content="ترجمة ملفات اللعبة بالذكاء الاصطناعي" Click="GameFiles_Click"/>
              <Button Content="مكتبة التعريبات العربية للألعاب" Click="GameLibrary_Click"/>

              <TextBlock Text="مشاكل؟" Style="{StaticResource L}" Margin="0,20,0,4"/>
              <Button Content="فتح سجل الأخطاء" Click="OpenLog_Click"/>
            </StackPanel>
          </TabItem>
        </TabControl>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="مكتبة التعريبات">
          <local:LocalizationLibraryWindow/>
        </TabItem>
      </TabControl>
    </ScrollViewer>
  </Grid>
</Window>