<Window x:Class="Flafyo.Desktop.GameFilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ترجمة ملفات اللعبة بالذكاء الاصطناعي" Icon="Assets/flafyo.ico" Width="640" Height="780" MinWidth="520" MinHeight="520"
        Background="#0E0F14" FlowDirection="RightToLeft" WindowStartupLocation="CenterOwner">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20">
      <TextBlock Text="ترجمة ملفات اللعبة" Foreground="#00D9A5" FontSize="20" FontWeight="Bold"/>
      <TextBlock Foreground="#FFC857" TextWrapping="Wrap" Margin="0,6,0,0"
                 Text="تنبيه: استخدمها في الألعاب الفردية بس. تعديل ملفات ألعاب أونلاين أو اللي عليها حماية ممكن يسبب حظر. البرنامج بيترجم نسخة من الملفات النصية (JSON وXML وCSV وPO وSRT وINI...) ومبيفتحش ملفات اللعبة المضغوطة أو المشفرة. الأصل بيتحفظ ويتسترجع بزرار."/>

      <TextBlock Text="مجلد اللعبة" Foreground="White" Margin="0,16,0,4"/>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="FolderBox" IsReadOnly="True" Padding="6"/>
        <Button Grid.Column="1" Content="اختر المجلد" Margin="8,0,0,0" Padding="12,6" Click="Browse_Click"/>
      </Grid>
      <CheckBox x:Name="PlainBox" Content="ترجمة ملفات .txt العادية كمان (ممكن تشمل ملفات مش للترجمة)" Foreground="White" Margin="0,10,0,0"/>
      <Button x:Name="ScanButton" Content="١) افحص الملفات" Margin="0,10,0,0" Padding="8" Click="Scan_Click"/>

      <TextBlock x:Name="CountText" Foreground="#9AA0B4" Margin="0,12,0,4"/>
      <StackPanel Orientation="Horizontal">
        <Button Content="تحديد الكل" Padding="10,4" Click="SelectAll_Click"/>
        <Button Content="إلغاء التحديد" Padding="10,4" Margin="8,0,0,0" Click="SelectNone_Click"/>
      </StackPanel>
      <ListBox x:Name="FilesList" Height="200" Margin="0,6,0,0" Background="#15161D" BorderBrush="#2A2D3A">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding Text}" Foreground="White" FlowDirection="LeftToRight"/>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <CheckBox x:Name="ShapeBox" Margin="0,14,0,0" Foreground="White"
                Content="تشكيل الحروف العربية وعكس الاتجاه (للألعاب اللي مش بتدعم العربي وبتعرض الحروف مقطعة)"/>
      <TextBlock Foreground="#9AA0B4" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12"
                 Text="الألعاب اللي بتدعم العربي من نفسها: سيب الخيار ده مقفول. وخط اللعبة لازم يكون فيه حروف عربية."/>

      <TextBlock Text="مكان الملفات المترجمة" Foreground="White" Margin="0,14,0,4"/>
      <TextBox x:Name="OutputBox" Padding="6"/>

      <Button x:Name="StartButton" Content="٢) ابدأ الترجمة" Margin="0,14,0,0" Padding="10" FontSize="15" Click="Start_Click"/>
      <Button x:Name="StopButton" Content="إيقاف (التقدم بيتحفظ)" Margin="0,8,0,0" Padding="8" IsEnabled="False" Click="Stop_Click"/>
      <ProgressBar x:Name="Bar" Height="14" Margin="0,10,0,0" Minimum="0" Maximum="100"/>
      <TextBlock x:Name="StatusText" Foreground="White" TextWrapping="Wrap" Margin="0,6,0,0"/>

      <TextBlock Text="٣) بعد الترجمة" Foreground="White" FontWeight="Bold" Margin="0,16,0,4"/>
      <StackPanel Orientation="Horizontal">
        <Button Content="فتح مجلد الناتج" Padding="10,6" Click="OpenOutput_Click"/>
        <Button x:Name="ApplyButton" Content="تطبيق على اللعبة (مع نسخة احتياطية)" Padding="10,6" Margin="8,0,0,0" Click="Apply_Click"/>
        <Button Content="استرجاع الأصل" Padding="10,6" Margin="8,0,0,0" Click="Restore_Click"/>
      </StackPanel>

      <TextBox x:Name="LogBox" Height="110" Margin="0,14,0,0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
               Background="#15161D" Foreground="#C9CEE0" FontSize="12"/>
    </StackPanel>
  </ScrollViewer>
</Window>
