<Window x:Class="Flafyo.Desktop.GameFilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ترجمة ملفات اللعبة" Icon="Assets/flafyo.ico" Width="700" Height="860" MinWidth="560" MinHeight="560"
        Background="{StaticResource Page}" FlowDirection="RightToLeft" FontFamily="Segoe UI, Tahoma" FontSize="13"
        WindowStartupLocation="CenterOwner">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="18">
      <TextBlock Text="ترجمة ملفات اللعبة بالذكاء الاصطناعي" FontSize="19" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
      <Border Background="#FFF4E5" BorderBrush="#F7B955" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,10,0,12">
        <TextBlock TextWrapping="Wrap" Foreground="#7A4B00"
                   Text="مهم: للألعاب الفردية بس. تعديل ملفات ألعاب أونلاين أو اللي عليها حماية ممكن يسبب حظر. البرنامج بيعمل نسخة مترجمة ومبيغيّرش الأصل غير لما تضغط «تطبيق»، وبيحفظ نسخة احتياطية. وخط اللعبة لازم يكون فيه حروف عربية، وإلا هتظهر مربعات."/>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="١) مجلد اللعبة" Style="{StaticResource H}"/>
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="FolderBox" IsReadOnly="True" Padding="7"/>
            <Button Grid.Column="1" Content="اختر المجلد" Margin="8,0,0,0" Click="Browse_Click"/>
          </Grid>
          <CheckBox x:Name="PlainBox" Content="شمل ملفات .txt العادية (ممكن تضم ملفات مش للترجمة)"/>
          <Button x:Name="ScanButton" Content="افحص الملفات" Margin="0,12,0,0" Style="{StaticResource PrimaryButton}" Click="Scan_Click"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="فحص ذكي: دوّر على ملفات نصوص اللعبة الفعلية" Style="{StaticResource H}"/>
          <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                     Text="بيفحص كل ملفات اللعبة وجوه أرشيفات ARC وZIP، وبيدوّر على جمل إنجليزي حقيقية، ويرتّب الملفات حسب كمية النصوص. مفيش ملف بيتغيّر. (للألعاب اللي نصوصها في صيغ خاصة زي Resident Evil 6)"/>
          <Button x:Name="ProbeButton" Content="ابدأ الفحص الذكي" Margin="0,10,0,0" Click="Probe_Click"/>
          <TextBlock x:Name="ProbeStatus" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
          <ListBox x:Name="ProbeList" Height="170" Margin="0,8,0,0" BorderBrush="{StaticResource Line}">
            <ListBox.ItemTemplate>
              <DataTemplate><TextBlock Text="{Binding Text}" TextWrapping="Wrap" FlowDirection="LeftToRight"/></DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBox x:Name="ProbePreview" Height="110" Margin="0,8,0,0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FlowDirection="LeftToRight" Padding="6"/>
          <WrapPanel Margin="0,8,0,0">
            <Button Content="تصدير نصوص الملف المحدد" Margin="0,0,8,0" Click="ExportHit_Click"/>
            <Button Content="فك الأرشيف المحدد (ARC)" Click="ExtractArc_Click"/>
          </WrapPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="فحص ذكي: دوّر على ملفات النصوص الفعلية (حتى جوه الأرشيفات)" Style="{StaticResource H}"/>
          <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                     Text="بيفحص كل ملفات اللعبة وجوه أرشيفات ARC وZIP، وبيدوّر على جمل إنجليزي حقيقية ويرتّب الملفات حسب كمية النصوص. مفيش ملف بيتغيّر."/>
          <Button x:Name="ProbeButton" Content="ابدأ الفحص الذكي" Margin="0,10,0,0" Click="Probe_Click"/>
          <TextBlock x:Name="ProbeStatus" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
          <ListBox x:Name="ProbeList" Height="170" Margin="0,8,0,0" BorderBrush="{StaticResource Line}" SelectionChanged="ProbeList_SelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate><TextBlock Text="{Binding Text}" TextWrapping="Wrap" FlowDirection="LeftToRight"/></DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBox x:Name="ProbePreview" Height="100" Margin="0,8,0,0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FlowDirection="LeftToRight" Padding="6"/>
          <WrapPanel Margin="0,8,0,0">
            <Button Content="تصدير نصوص العنصر المحدد" Margin="0,0,8,0" Click="ExportHit_Click"/>
            <Button Content="استخراج الأرشيف" Click="ExtractArc_Click"/>
          </WrapPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="٢) اختار الملفات" Style="{StaticResource H}"/>
          <TextBlock x:Name="CountText" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="المقترحة بس" Click="SelectSuggested_Click"/>
            <Button Content="الكل" Margin="8,0,0,0" Click="SelectAll_Click"/>
            <Button Content="مفيش" Margin="8,0,0,0" Click="SelectNone_Click"/>
          </StackPanel>
          <ListBox x:Name="FilesList" Height="190" Margin="0,10,0,0" BorderBrush="{StaticResource Line}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding Text}" FlowDirection="LeftToRight" Margin="0,2,0,2"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="نماذج من النصوص في الملف اللي دوست عليه (اتأكد إنها كلام فعلاً مش أكواد):" Style="{StaticResource L}"/>
          <TextBox x:Name="PreviewBox" Height="120" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FlowDirection="LeftToRight" Padding="6"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="٣) الترجمة" Style="{StaticResource H}"/>
          <CheckBox x:Name="QuickBox" IsChecked="True" Content="اختبار سريع: أول 30 نص من كل ملف بس (جرّبه الأول قبل الترجمة الكاملة)"/>
          <CheckBox x:Name="ShapeBox" Content="تشكيل الحروف العربية وعكس الاتجاه (للألعاب اللي بتعرض الحروف مقطعة)"/>
          <TextBlock Text="مكان الملفات المترجمة" Style="{StaticResource L}"/>
          <TextBox x:Name="OutputBox" Padding="7"/>
          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="StartButton" Content="ابدأ الترجمة" Style="{StaticResource PrimaryButton}" Click="Start_Click"/>
            <Button x:Name="StopButton" Grid.Column="1" Content="إيقاف" Margin="8,0,0,0" IsEnabled="False" Click="Stop_Click"/>
          </Grid>
          <ProgressBar x:Name="Bar" Height="12" Margin="0,12,0,0" Minimum="0" Maximum="100"/>
          <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource Ink}"/>
          <TextBlock x:Name="EtaText" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="٤) بعد الترجمة" Style="{StaticResource H}"/>
          <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                     Text="افتح مجلد الناتج وراجع الملفات. لما تتأكد، «تطبيق على اللعبة» بيستبدل الملفات بعد ما يحفظ الأصل. لو اللعبة بوظت، «استرجاع الأصل» بيرجّع كل حاجة."/>
          <WrapPanel Margin="0,10,0,0">
            <Button Content="فتح مجلد الناتج" Margin="0,0,8,8" Click="OpenOutput_Click"/>
            <Button x:Name="ApplyButton" Content="تطبيق على اللعبة (مع نسخة احتياطية)" Margin="0,0,8,8" Click="Apply_Click"/>
            <Button Content="استرجاع الأصل" Margin="0,0,8,8" Click="Restore_Click"/>
          </WrapPanel>
        </StackPanel>
      </Border>

      <TextBlock Text="تفاصيل" Style="{StaticResource L}"/>
      <TextBox x:Name="LogBox" Height="110" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="12" Padding="6"/>
    </StackPanel>
  </ScrollViewer>
</Window>
