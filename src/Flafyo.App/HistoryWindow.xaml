<Window x:Class="Flafyo.Desktop.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="السجل وتصحيح الترجمة" Icon="Assets/flafyo.ico" Width="1040" Height="760" MinWidth="700" MinHeight="580"
        Background="{StaticResource Page}" FlowDirection="RightToLeft" FontFamily="Segoe UI, Tahoma" FontSize="13" WindowStartupLocation="CenterOwner">
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16">
      <TextBlock Text="سجل الترجمة والتصحيحات" Foreground="{StaticResource Accent}" FontSize="23" FontWeight="Bold"/>
      <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"
                 Text="راجع الترجمات السابقة، واختر الجملة التي تحتاج إلى تعديل. التصحيح المحفوظ يُستخدم عند ظهور الجملة نفسها مرة أخرى."/>
    </StackPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="سجل الجمل" Foreground="{StaticResource Ink}" FontSize="16" FontWeight="Bold"/>
            <TextBlock Text="حدد جملة لعرض النص والترجمة وتعديلها." Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
          </StackPanel>
          <ListBox x:Name="List" Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource Line}" SelectionChanged="List_SelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="9,8">
                  <TextBlock Text="{Binding Display}" Foreground="{StaticResource Ink}" TextWrapping="Wrap"/>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
        <StackPanel>
          <TextBlock Text="مراجعة التصحيح" Foreground="{StaticResource Accent}" FontSize="16" FontWeight="Bold"/>
          <TextBlock Text="الجملة الأصلية" Foreground="{StaticResource Ink}" Margin="0,16,0,6" FontWeight="SemiBold"/>
          <TextBox x:Name="SourceBox" IsReadOnly="True" Padding="10" MinHeight="90" TextWrapping="Wrap" FlowDirection="LeftToRight" VerticalScrollBarVisibility="Auto"/>
          <TextBlock Text="الترجمة العربية" Foreground="{StaticResource Ink}" Margin="0,16,0,6" FontWeight="SemiBold"/>
          <TextBox x:Name="ArabicBox" Padding="10" MinHeight="120" TextWrapping="Wrap" AcceptsReturn="True" FontSize="15" VerticalScrollBarVisibility="Auto"/>
          <TextBlock Text="عدّل الترجمة ثم احفظ التصحيح لاستخدامه لاحقًا." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
          <WrapPanel Margin="0,16,0,0">
            <Button Content="حفظ التصحيح" Padding="14,8" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" Click="Save_Click"/>
            <Button Content="تحديث السجل" Padding="14,8" Margin="0,0,8,8" Click="Refresh_Click"/>
            <Button Content="إغلاق" Padding="14,8" Margin="0,0,8,8" Click="Close_Click"/>
          </WrapPanel>
          <Border Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,8,0,0">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource Warn}" TextWrapping="Wrap"/>
          </Border>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
