<Window x:Class="Flafyo.Desktop.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="السجل وتصحيح الترجمة" Icon="Assets/flafyo.ico" Width="640" Height="640" MinWidth="480" MinHeight="460"
        Background="#0E0F14" FlowDirection="RightToLeft" WindowStartupLocation="CenterOwner">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="السجل وتصحيح الترجمة" Foreground="#00D9A5" FontSize="18" FontWeight="Bold"/>
      <TextBlock Foreground="#9AA0B4" TextWrapping="Wrap" Margin="0,4,0,8"
                 Text="اختار جملة ترجمتها مش مظبوطة، عدّل الترجمة، واضغط حفظ. البرنامج هيستخدم تصحيحك في كل مرة الجملة دي تظهر."/>
    </StackPanel>
    <ListBox x:Name="List" Grid.Row="1" Background="#15161D" BorderBrush="#2A2D3A" SelectionChanged="List_SelectionChanged">
      <ListBox.ItemTemplate>
        <DataTemplate><TextBlock Text="{Binding Display}" Foreground="White" TextWrapping="Wrap"/></DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Grid.Row="2" Margin="0,12,0,0">
      <TextBlock Text="الجملة الأصلية" Foreground="White"/>
      <TextBox x:Name="SourceBox" IsReadOnly="True" Padding="6" Margin="0,4,0,0" TextWrapping="Wrap" FlowDirection="LeftToRight"/>
      <TextBlock Text="الترجمة (عدّلها)" Foreground="White" Margin="0,10,0,0"/>
      <TextBox x:Name="ArabicBox" Padding="6" Margin="0,4,0,0" TextWrapping="Wrap" AcceptsReturn="False" FontSize="15"/>
      <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
        <Button Content="احفظ التصحيح" Padding="14,6" Click="Save_Click"/>
        <Button Content="تحديث السجل" Padding="14,6" Margin="8,0,0,0" Click="Refresh_Click"/>
        <Button Content="إغلاق" Padding="14,6" Margin="8,0,0,0" Click="Close_Click"/>
      </StackPanel>
      <TextBlock x:Name="StatusText" Foreground="#FFC857" Margin="0,8,0,0" TextWrapping="Wrap"/>
    </StackPanel>
  </Grid>
</Window>
