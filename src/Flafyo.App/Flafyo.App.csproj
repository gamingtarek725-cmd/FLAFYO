<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>FLAFYO.GameTranslator</AssemblyName>
    <RootNamespace>Flafyo.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\flafyo.ico</ApplicationIcon>
    <Version>0.3.3</Version>
    <Copyright>© 2026 FLAFYO. All rights reserved.</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\flafyo.ico" />
    <Resource Include="Assets\logo.png" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Flafyo.Windows/Flafyo.Windows.csproj" />
  </ItemGroup>
</Project>
