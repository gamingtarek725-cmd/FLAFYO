<Window x:Class="Flafyo.Desktop.AppearanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="شكل الترجمة" Icon="Assets/flafyo.ico" Width="820" Height="940" MinWidth="600" MinHeight="700"
        Background="{StaticResource Page}" FlowDirection="RightToLeft" FontFamily="Segoe UI, Tahoma" FontSize="13" WindowStartupLocation="CenterOwner">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24">
      <TextBlock Text="تخصيص مظهر الترجمة" Foreground="{StaticResource Accent}" FontSize="24" FontWeight="Bold"/>
      <TextBlock Text="اضبط شكل شريط الترجمة ومكانه وطريقة عرض النصوص. التغييرات تُطبّق مباشرة." Foreground="{StaticResource Muted}" Margin="0,6,0,18" TextWrapping="Wrap"/>

      <Border Style="{StaticResource Card}" Margin="0,0,0,14">
        <StackPanel>
          <TextBlock Text="01  تنسيق النص" Foreground="{StaticResource Accent}" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
          <TextBlock Text="نوع الخط" Foreground="{StaticResource Ink}" Margin="0,0,0,5"/>
          <ComboBox x:Name="FontBox" SelectionChanged="OnSelect"/>
          <StackPanel Orientation="Horizontal" Margin="0,14,0,4">
            <TextBlock Text="حجم الخط" Foreground="{StaticResource Ink}"/>
            <TextBlock x:Name="SizeLabel" Foreground="{StaticResource Warn}" Margin="8,0,0,0" FontWeight="Bold"/>
          </StackPanel>
          <Slider x:Name="SizeSlider" Minimum="12" Maximum="72" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnSlide"/>
          <WrapPanel Margin="0,8,0,0">
            <CheckBox x:Name="BoldCheck" Content="خط عريض" Foreground="{StaticResource Ink}" Margin="0,0,24,8" Checked="OnToggle" Unchecked="OnToggle"/>
            <CheckBox x:Name="ShadowCheck" Content="إضافة ظل للنص" Foreground="{StaticResource Ink}" Margin="0,0,0,8" Checked="OnToggle" Unchecked="OnToggle"/>
          </WrapPanel>
          <TextBlock Text="محاذاة الكلام" Foreground="{StaticResource Ink}" Margin="0,8,0,5"/>
          <ComboBox x:Name="AlignBox" SelectionChanged="OnSelect">
            <ComboBoxItem Content="يمين (الأنسب للعربي)"/>
            <ComboBoxItem Content="وسط"/>
            <ComboBoxItem Content="يسار"/>
          </ComboBox>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,0,0,14">
        <StackPanel>
          <TextBlock Text="02  الألوان والخلفية" Foreground="{StaticResource Accent}" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="لون الكلام" Foreground="{StaticResource Ink}" Margin="0,0,0,5"/>
              <ComboBox x:Name="TextColorBox" SelectionChanged="OnSelect"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="لون الخلفية" Foreground="{StaticResource Ink}" Margin="0,0,0,5"/>
              <ComboBox x:Name="BackColorBox" SelectionChanged="OnSelect"/>
            </StackPanel>
          </Grid>
          <StackPanel Orientation="Horizontal" Margin="0,14,0,4">
            <TextBlock Text="شفافية الخلفية" Foreground="{StaticResource Ink}"/>
            <TextBlock x:Name="OpacityLabel" Foreground="{StaticResource Warn}" Margin="8,0,0,0" FontWeight="Bold"/>
          </StackPanel>
          <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="OnSlide"/>
          <CheckBox x:Name="BorderCheck" Content="إظهار إطار حول شريط الترجمة" Foreground="{StaticResource Ink}" Margin="0,12,0,8" Checked="OnToggle" Unchecked="OnToggle"/>
          <TextBlock Text="لون الإطار" Foreground="{StaticResource Ink}" Margin="0,0,0,5"/>
          <ComboBox x:Name="BorderColorBox" SelectionChanged="OnSelect"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,0,0,14">
        <StackPanel>
          <TextBlock Text="03  موضع الشريط وسلوكه" Foreground="{StaticResource Accent}" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
          <TextBlock Text="مكان ظهور الترجمة" Foreground="{StaticResource Ink}" Margin="0,0,0,5"/>
          <ComboBox x:Name="ModeBox" SelectionChanged="OnSelect">
            <ComboBoxItem Content="فوق منطقة النص (تلقائي)"/>
            <ComboBoxItem Content="تحت منطقة النص (تلقائي)"/>
            <ComboBoxItem Content="مكان ثابت أحدده بنفسي"/>
          </ComboBox>
          <Button x:Name="AreaButton" Content="تحديد مكان وحجم الشريط بالماوس" Margin="0,10,0,0" Padding="10,8" Click="Area_Click"/>
          <TextBlock x:Name="AreaText" Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Margin="0,14,0,4">
            <TextBlock Text="عرض الشريط" Foreground="{StaticResource Ink}"/>
            <TextBlock x:Name="WidthLabel" Foreground="{StaticResource Warn}" Margin="8,0,0,0" FontWeight="Bold"/>
          </StackPanel>
          <Slider x:Name="WidthSlider" Minimum="0" Maximum="1800" TickFrequency="20" IsSnapToTickEnabled="True" ValueChanged="OnSlide"/>
          <TextBlock Text="الإخفاء التلقائي" Foreground="{StaticResource Ink}" Margin="0,12,0,4"/>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="إخفاء الترجمة بعد:" Foreground="{StaticResource Muted}"/>
            <TextBlock x:Name="HideLabel" Foreground="{StaticResource Warn}" Margin="8,0,0,0" FontWeight="Bold"/>
          </StackPanel>
          <Slider x:Name="HideSlider" Minimum="0" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnSlide"/>
          <CheckBox x:Name="OriginalCheck" Content="عرض النص الإنجليزي الأصلي تحت الترجمة" Foreground="{StaticResource Ink}" Margin="0,12,0,0" Checked="OnToggle" Unchecked="OnToggle"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,0,0,14">
        <StackPanel>
          <TextBlock Text="04  العناوين والقوائم" Foreground="{StaticResource Accent}" FontSize="16" FontWeight="Bold" Margin="0,0,0,6"/>
          <TextBlock Text="إعدادات إضافية لوضع الشاشة كاملة، لتمييز العناوين عن النصوص العادية." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
          <TextBlock Text="لون العناوين" Foreground="{StaticResource Ink}" Margin="0,0,0,5"/>
          <ComboBox x:Name="HeadingColorBox" SelectionChanged="OnSelect"/>
          <StackPanel Orientation="Horizontal" Margin="0,14,0,4">
            <TextBlock Text="حجم العناوين مقارنة بباقي النص" Foreground="{StaticResource Ink}"/>
            <TextBlock x:Name="HeadingScaleLabel" Foreground="{StaticResource Warn}" Margin="8,0,0,0" FontWeight="Bold"/>
          </StackPanel>
          <Slider x:Name="HeadingScaleSlider" Minimum="100" Maximum="250" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="OnSlide"/>
          <WrapPanel Margin="0,8,0,0">
            <CheckBox x:Name="HeadingBoldCheck" Content="العناوين بخط عريض" Foreground="{StaticResource Ink}" Margin="0,0,24,8" Checked="OnToggle" Unchecked="OnToggle"/>
            <CheckBox x:Name="AutoFitCheck" Content="ضبط حجم الخط تلقائياً حسب النص الأصلي" Foreground="{StaticResource Ink}" Margin="0,0,0,8" Checked="OnToggle" Unchecked="OnToggle"/>
          </WrapPanel>
          <Button Content="معاينة وضع الشاشة كاملة" Margin="0,8,0,0" Padding="10,8" Click="PreviewScreen_Click"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,0,0,8">
        <StackPanel>
          <TextBlock Text="معاينة وتطبيق" Foreground="{StaticResource Accent}" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
          <TextBlock Text="استخدم المعاينة لمراجعة شكل الترجمة قبل الرجوع للعبة." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
          <WrapPanel>
            <Button Content="معاينة الترجمة" Padding="16,8" Margin="0,0,8,8" Click="Preview_Click"/>
            <Button Content="إعادة الضبط" Padding="16,8" Margin="0,0,8,8" Click="Reset_Click"/>
            <Button Content="إغلاق" Padding="16,8" Margin="0,0,8,8" Click="Close_Click"/>
          </WrapPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Window>
